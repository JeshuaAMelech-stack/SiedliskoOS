{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiedliskoOS",
  "version": "0.2.0",
  "identifier": "pl.siedliskoos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SiedliskoOS",
        "width": 1400,
        "height": 860,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:siedliskoos.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNUNBMjcyRkE0RTFBNkEKUldScUdrNzZjcUpjVEZaazF0dko3b2I5QW5qK0l6enFCeEd5Zkw1V3JLbDkyRGp2WXhka01sV2EK",
      "endpoints": [
        "https://github.com/JeshuaAMelech-stack/SiedliskoOS/releases/latest/download/latest.json"
      ]
    }
  }
}
